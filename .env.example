# ===== Supabase (مطلوب) =====
# من لوحة مشروع Supabase: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# مفتاح الخدمة (سرّي — لا يصل للمتصفح أبدًا). مطلوب للنسخ الاحتياطي وإنشاء المستخدمين
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ===== النسخ الاحتياطي التلقائي (Vercel Cron) =====
# أي نص عشوائي طويل — يحمي مسار /api/cron/backup
CRON_SECRET=change-me-to-a-long-random-string
